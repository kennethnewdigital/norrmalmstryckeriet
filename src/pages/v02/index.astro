          </span>
        </a>

        <a href="/produkter/broschyrer" class="bg-[#F5F5F5] rounded-[20px] p-[28px] flex flex-col group hover:bg-[#EBEBEB] transition-colors duration-200 no-underline relative">
          <img src="/images/icons/broschyrer-1.svg" alt="Broschyrer och kataloger" class="w-[64px] h-[64px] mb-[12px]" />
          <span class="typo-card-title">Broschyrer<br/>och kataloger</span>
          <span class="mt-auto self-end text-[#222]">
            <svg width="32" height="32" viewBox="0 0 512 512" fill="currentColor"><path d="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm144 276c0 6.6-5.4 12-12 12h-92v92c0 6.6-5.4 12-12 12h-56c-6.6 0-12-5.4-12-12v-92h-92c-6.6 0-12-5.4-12-12v-56c0-6.6 5.4-12 12-12h92v-92c0-6.6 5.4-12 12-12h56c6.6 0 12 5.4 12 12v92h92c6.6 0 12 5.4 12 12v56z"/></svg>
          </span>
        </a>

        <a href="/produkter/mappar" class="bg-[#F5F5F5] rounded-[20px] p-[28px] flex flex-col group hover:bg-[#EBEBEB] transition-colors duration-200 no-underline relative">
          <img src="/images/icons/mappar-1.svg" alt="Presentationsmappar" class="w-[64px] h-[64px] mb-[12px]" />
          <span class="typo-card-title">Presentations-<br/>mappar</span>
          <span class="mt-auto self-end text-[#222]">
            <svg width="32" height="32" viewBox="0 0 512 512" fill="currentColor"><path d="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm144 276c0 6.6-5.4 12-12 12h-92v92c0 6.6-5.4 12-12 12h-56c-6.6 0-12-5.4-12-12v-92h-92c-6.6 0-12-5.4-12-12v-56c0-6.6 5.4-12 12-12h92v-92c0-6.6 5.4-12 12-12h56c6.6 0 12 5.4 12 12v92h92c6.6 0 12 5.4 12 12v56z"/></svg>
          </span>
        </a>

        <a href="/produkter/affischer" class="bg-[#F5F5F5] rounded-[20px] p-[28px] flex flex-col group hover:bg-[#EBEBEB] transition-colors duration-200 no-underline relative">
          <img src="/images/icons/affischer-1.svg" alt="Affischer" class="w-[64px] h-[64px] mb-[12px]" />
          <span class="typo-card-title">Affischer</span>
          <span class="mt-auto self-end text-[#222]">
            <svg width="32" height="32" viewBox="0 0 512 512" fill="currentColor"><path d="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm144 276c0 6.6-5.4 12-12 12h-92v92c0 6.6-5.4 12-12 12h-56c-6.6 0-12-5.4-12-12v-92h-92c-6.6 0-12-5.4-12-12v-56c0-6.6 5.4-12 12-12h92v-92c0-6.6 5.4-12 12-12h56c6.6 0 12 5.4 12 12v92h92c6.6 0 12 5.4 12 12v56z"/></svg>
          </span>
        </a>

        <a href="/produkter/kuvert" class="bg-[#F5F5F5] rounded-[20px] p-[28px] flex flex-col group hover:bg-[#EBEBEB] transition-colors duration-200 no-underline relative">
          <img src="/images/icons/kuvert-1.svg" alt="Kuvert" class="w-[64px] h-[64px] mb-[12px]" />
          <span class="typo-card-title">Kuvert</span>
          <span class="mt-auto self-end text-[#222]">
            <svg width="32" height="32" viewBox="0 0 512 512" fill="currentColor"><path d="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm144 276c0 6.6-5.4 12-12 12h-92v92c0 6.6-5.4 12-12 12h-56c-6.6 0-12-5.4-12-12v-92h-92c-6.6 0-12-5.4-12-12v-56c0-6.6 5.4-12 12-12h92v-92c0-6.6 5.4-12 12-12h56c6.6 0 12 5.4 12 12v92h92c6.6 0 12 5.4 12 12v56z"/></svg>
          </span>
        </a>

        <a href="/produkter/bocker" class="col-span-2 bg-[#F5F5F5] rounded-[20px] p-[28px] flex flex-row items-center gap-[24px] group hover:bg-[#EBEBEB] transition-colors duration-200 no-underline relative">
          <img src="/images/icons/bocker-1.svg" alt="Böcker" class="w-[80px] h-[80px] shrink-0" />
          <span class="typo-card-title">Böcker</span>
          <span class="ml-auto text-[#222]">
            <svg width="32" height="32" viewBox="0 0 512 512" fill="currentColor"><path d="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm144 276c0 6.6-5.4 12-12 12h-92v92c0 6.6-5.4 12-12 12h-56c-6.6 0-12-5.4-12-12v-92h-92c-6.6 0-12-5.4-12-12v-56c0-6.6 5.4-12 12-12h92v-92c0-6.6 5.4-12 12-12h56c6.6 0 12 5.4 12 12v92h92c6.6 0 12 5.4 12 12v56z"/></svg>
          </span>
        </a>

