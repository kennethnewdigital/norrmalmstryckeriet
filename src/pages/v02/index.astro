<script>
  function initHomepageV2() {
    // === Hero video lazy-load + seamless fade ===
    const heroVideo = document.getElementById('hero-video') as HTMLIFrameElement | null;
    if (heroVideo && heroVideo.dataset.src && !heroVideo.src) {
      const heroSection = heroVideo.closest('section');
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && heroVideo.dataset.src) {
              heroVideo.src = heroVideo.dataset.src;
              delete heroVideo.dataset.src;
              heroVideo.addEventListener('load', () => {
                setTimeout(() => {
                  heroVideo.style.opacity = '1';
                }, 600);
              }, { once: true });
              observer.unobserve(entry.target);
            }
          });
        },
        { rootMargin: '200px' }
      );
      if (heroSection) observer.observe(heroSection);
    }

    // === FAQ Accordion (utan tabs på v2) ===
    document.querySelectorAll('.faq-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const answer = btn.nextElementSibling as HTMLElement;
        const plusIcon = btn.querySelector('.faq-plus') as HTMLElement;
        const minusIcon = btn.querySelector('.faq-minus') as HTMLElement;
        const isOpen = answer.classList.contains('is-open');

        // Stäng alla andra
        document.querySelectorAll('.faq-answer').forEach((a) => {
          (a as HTMLElement).style.maxHeight = '0';
          a.classList.remove('is-open');
        });
        document.querySelectorAll('.faq-plus').forEach((p) => p.classList.remove('hidden'));
        document.querySelectorAll('.faq-minus').forEach((m) => m.classList.add('hidden'));

        if (!isOpen) {
          answer.classList.add('is-open');
          answer.style.maxHeight = answer.scrollHeight + 'px';
          plusIcon.classList.add('hidden');
          minusIcon.classList.remove('hidden');
        }
      });
    });

    // === Scroll ett kort i taget (gap = 20px, produktscroll 16-20px) ===
    function scrollOneCard(carousel: HTMLElement | null, direction: 1 | -1, gap = 20) {
      if (!carousel) return;
      const firstCard = carousel.querySelector<HTMLElement>(':scope > a');
      const step = firstCard ? firstCard.offsetWidth + gap : 400;
      carousel.scrollBy({ left: direction * step, behavior: 'smooth' });
    }

    const productCarousel = document.getElementById('product-carousel');
    document.getElementById('carousel-prev')?.addEventListener('click', () => scrollOneCard(productCarousel, -1, 16));
    document.getElementById('carousel-next')?.addEventListener('click', () => scrollOneCard(productCarousel, 1, 16));

    const refCarousel = document.getElementById('ref-carousel');
    document.getElementById('ref-prev')?.addEventListener('click', () => scrollOneCard(refCarousel, -1, 20));
    document.getElementById('ref-next')?.addEventListener('click', () => scrollOneCard(refCarousel, 1, 20));

    const guideCarousel = document.getElementById('guide-carousel');
    document.getElementById('guide-prev')?.addEventListener('click', () => scrollOneCard(guideCarousel, -1, 20));
    document.getElementById('guide-next')?.addEventListener('click', () => scrollOneCard(guideCarousel, 1, 20));
  }

  initHomepageV2();
  document.addEventListener('astro:after-swap', initHomepageV2);
</script>
