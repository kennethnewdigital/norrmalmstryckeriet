---
import Layout from '../../layouts/Layout.astro';
import { websiteSchema, faqPageSchema, graph } from '../../lib/schema';

// v2 — kondenserad FAQ (6 köpfrågor, inte 21 tekniska)
const faqs = [
  {
    q: 'Vad behöver ni för att kunna lämna pris?',
    a: 'Berätta vad du vill trycka, ungefärligt antal och när du behöver det klart. Format, papper och efterbehandling går vi igenom tillsammans om du är osäker. Har du en tryckfärdig PDF kan du bifoga den – annars räcker det med en beskrivning eller en skiss.',
  },
  {
    q: 'Kan ni hjälpa mig välja papper och format?',
    a: 'Ja. Vi rekommenderar papper, format och tryckmetod utifrån vad trycksaken ska användas till, hur många exemplar du behöver och vilken deadline som gäller. Du behöver inte veta trycktermer i förväg.',
  },
  {
    q: 'Kan ni kontrollera min fil före tryck?',
    a: 'Ja. Vi går igenom fil, format, utfall, marginaler, bildkvalitet och färger innan produktionen startar. Är något oklart hör vi av oss innan vi kör.',
  },
  {
    q: 'Hur snabbt kan ni leverera?',
    a: 'Det beror på produkt, upplaga, papper, efterbehandling och aktuell beläggning i produktionen. Berätta när du behöver materialet så säger vi vad som är möjligt.',
  },
  {
    q: 'Kan ni skicka till flera adresser?',
    a: 'Ja. Vi packar och levererar till kontor, butiker eller slutkunder – och kan lagra material hos oss och skicka ut vid behov.',
  },
  {
    q: 'Vad innebär det att tryckeriet är Svanenmärkt?',
    a: 'Att vår verksamhet uppfyller Svanens krav för tryckerier – det gäller material, kemikalier, energi, återvinning och rutiner i produktionen. Ska en enskild trycksak bära Svanenmärket reder vi ut vad som krävs innan produktion.',
  },
];

const pageSchemas = graph(websiteSchema(), faqPageSchema(faqs));

// v2 — kundreferenser flyttade upp före processen
const kundref = [
  { name: 'Memira', href: '/kundreferenser/memira', image: '/images/references/memira.webp' },
  { name: 'Sv. Curlingförbundet', href: '/kundreferenser/curlingforbundet', image: '/images/references/curling.webp' },
  { name: 'Kyrkbyrån', href: '/kundreferenser/kyrkbyran', image: '/images/references/kyrkbyran.webp' },
  { name: 'Odelius & Co', href: '/kundreferenser/odelius', image: '/images/references/odelius.webp' },
  { name: 'Zetatrade', href: '/kundreferenser/zetatrade', image: '/images/references/zetatrade.webp' },
];
---

<Layout
  title="Trycksaker som blir rätt från början — v2 preview | Norrmalmstryckeriet"
  description="Få personlig hjälp med fil, papper, färg, produktion och leverans från vårt Svanenmärkta tryckeri i Sollentuna. Du behöver inte veta vilken tryckmetod du ska välja – det hjälper vi dig med."
  schemaJson={pageSchemas}
  noindex={true}
>

  <!-- ═══ HERO ═══ -->
  <!-- MOBILE+TABLET HERO -->
  <section class="lg:hidden">
    <div class="mx-[16px] sm:mx-[24px] md:mx-[32px] mt-[16px] sm:mt-[24px]">
      <div class="rounded-[20px] sm:rounded-[28px] overflow-hidden aspect-[4/3] sm:aspect-[16/9] md:aspect-[2/1] mb-[24px] sm:mb-[32px]">
        <img
          src="/images/hero/hero-tryckpress.webp"
          alt="Tryckpress på Norrmalmstryckeriet"
          class="w-full h-full object-cover"
        />
      </div>
      <div class="px-[4px] sm:px-[8px] md:px-[16px] max-w-[760px]">
        <h1 class="font-[var(--font-heading)] !font-normal text-[#222] mb-[16px] sm:mb-[20px]" style="font-size: clamp(1.875rem, 5vw + 0.5rem, 3.5rem); line-height: 1.05; letter-spacing: -0.025em; text-wrap: balance;" lang="sv">
          Trycksaker som blir rätt från början
        </h1>
        <p class="text-[#444] text-[15px] sm:text-[16px] md:text-[18px] leading-relaxed mb-[24px]">
          Få personlig hjälp med fil, papper, färg, produktion och leverans från vårt Svanenmärkta tryckeri i Sollentuna. Du behöver inte veta vilken tryckmetod du ska välja – det hjälper vi dig med.
        </p>
        <div class="flex flex-col sm:flex-row gap-[10px] sm:gap-[12px] mb-[16px]">
          <a href="tel:+4686960135" class="btn-pill btn-red w-full sm:w-auto justify-center inline-flex">
            <strong>Ring</strong> 08-96 01 35<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="inline-block ml-1"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </a>
          <a href="/offert#formular" class="btn-pill w-full sm:w-auto justify-center inline-flex" style="background: #F3F3F3; color: #222;">
            Få en offert
          </a>
        </div>
        <p class="text-[#444] text-[15px] sm:text-[16px] leading-relaxed">
          Osäker på papper, format eller fil? Ring ändå – vi hjälper dig reda ut vad som behövs.
        </p>
      </div>
    </div>
  </section>

  <!-- DESKTOP HERO (lg+): video overlay -->
  <section class="relative hidden lg:block">
    <div class="hero-box-index mx-[34px] xl:mx-[44px] mt-[24px] rounded-[50px] overflow-hidden relative">
      <img
        src="/images/hero/hero-tryckpress.webp"
        alt="Tryckpress på Norrmalmstryckeriet"
        class="absolute inset-0 w-full h-full object-cover"
      />
      <iframe
        id="hero-video"
        data-src="https://www.youtube.com/embed/kJhvwU8M1Ew?autoplay=1&mute=1&loop=1&playlist=kJhvwU8M1Ew&controls=0&showinfo=0&modestbranding=1&playsinline=1&rel=0"
        title="Norrmalmstryckeriet"
        class="absolute inset-0 w-full h-full scale-[1.2] pointer-events-none opacity-0 transition-opacity duration-700 ease-out"
        allow="autoplay; encrypted-media"
        allowfullscreen
        loading="lazy"
      ></iframe>
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent pointer-events-none"></div>
      <div class="absolute bottom-[40px] left-[40px] right-[40px] xl:bottom-[60px] xl:left-[60px] xl:right-[60px] z-10 max-w-[820px]">
        <h2 class="typo-hero !text-white mb-[20px]">
          Trycksaker som blir rätt från början
        </h2>
        <p class="!text-white/85 text-[16px] xl:text-[18px] leading-relaxed mb-[28px] max-w-[640px]">
          Få personlig hjälp med fil, papper, färg, produktion och leverans från vårt Svanenmärkta tryckeri i Sollentuna. Du behöver inte veta vilken tryckmetod du ska välja – det hjälper vi dig med.
        </p>
        <div class="flex flex-wrap gap-[12px]">
          <a href="tel:+4686960135" class="btn-pill btn-red inline-flex">
            <strong>Ring</strong> 08-96 01 35<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="inline-block ml-1"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </a>
          <a href="/offert#formular" class="btn-pill inline-flex" style="background: rgba(255,255,255,0.92); color: #222;">
            Få en offert
          </a>
        </div>
        <p class="!text-white/85 text-[15px] sm:text-[16px] mt-[16px]">
          Osäker på papper, format eller fil? Ring ändå – vi hjälper dig reda ut vad som behövs.
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ LOGO BAR med intro-text (matchar hero-padding) ═══ -->
  <section class="pt-[40px] pb-[20px] mx-[16px] sm:mx-[24px] md:mx-[32px] lg:mx-[34px] xl:mx-[44px]">
    <p class="text-left text-[14px] sm:text-[15px] text-[#666] mb-[24px] font-[var(--font-body)]">
      Företag och organisationer som har valt oss för sin trycksaksproduktion
    </p>
    <div class="overflow-hidden">
      <div class="logo-carousel-track" style="gap:100px;">
        <img src="/images/logos/tekompaniet.svg" alt="Tekompaniet" class="shrink-0 h-[28px] w-auto opacity-80" />
        <img src="/images/logos/kyrkbyran.svg" alt="Kyrkbyrån" class="shrink-0 h-[18px] w-auto opacity-80" />
        <img src="/images/logos/svenska_curligforbundet.svg" alt="Svenska Curlingförbundet" class="shrink-0 h-[40px] w-auto opacity-80" />
        <img src="/images/logos/capio.svg" alt="Capio" class="shrink-0 h-[24px] w-auto opacity-80" />
        <img src="/images/logos/sandvik_logotype_black_rgb.svg" alt="Sandvik" class="shrink-0 h-[24px] w-auto opacity-80" />
        <img src="/images/logos/memira.svg" alt="Memira" class="shrink-0 h-[24px] w-auto opacity-80" />
        <img src="/images/logos/Essity_logo.svg" alt="Essity" class="shrink-0 h-[26px] w-auto opacity-80" />
        <img src="/images/logos/Jureskog_logo_small.svg" alt="Jureskog" class="shrink-0 h-[44px] w-auto opacity-80" />
        <img src="/images/logos/zetatrade.svg" alt="Zetatrade" class="shrink-0 h-[34px] w-auto opacity-80" />
        <img src="/images/logos/tekompaniet.svg" alt="Tekompaniet" class="shrink-0 h-[28px] w-auto opacity-80" />
        <img src="/images/logos/kyrkbyran.svg" alt="Kyrkbyrån" class="shrink-0 h-[18px] w-auto opacity-80" />
        <img src="/images/logos/svenska_curligforbundet.svg" alt="Svenska Curlingförbundet" class="shrink-0 h-[40px] w-auto opacity-80" />
        <img src="/images/logos/capio.svg" alt="Capio" class="shrink-0 h-[24px] w-auto opacity-80" />
        <img src="/images/logos/sandvik_logotype_black_rgb.svg" alt="Sandvik" class="shrink-0 h-[24px] w-auto opacity-80" />
        <img src="/images/logos/memira.svg" alt="Memira" class="shrink-0 h-[24px] w-auto opacity-80" />
        <img src="/images/logos/Essity_logo.svg" alt="Essity" class="shrink-0 h-[26px] w-auto opacity-80" />
        <img src="/images/logos/Jureskog_logo_small.svg" alt="Jureskog" class="shrink-0 h-[44px] w-auto opacity-80" />
        <img src="/images/logos/zetatrade.svg" alt="Zetatrade" class="shrink-0 h-[34px] w-auto opacity-80" />
      </div>
    </div>
  </section>

  <!-- ═══ VAD VILL DU TRYCKA? — kondenserade namn + osäkerhet-CTA ═══ -->
  <section class="pt-[40px] pb-[80px] lg:pt-[60px] lg:pb-[120px]">
    <div class="lg:max-w-[1440px] lg:mx-auto lg:px-[44px]">
      <h3 class="typo-carousel-heading ml-[16px] sm:ml-[24px] md:ml-[32px] lg:ml-0 mb-[20px] sm:mb-[28px]">Vad vill du trycka?</h3>
    </div>

    <!-- MOBILE/TABLET: sidoscroll-kort -->
    <div class="lg:hidden">
      <div id="product-carousel" class="flex gap-[16px] sm:gap-[20px] overflow-x-auto scrollbar-hide pl-[16px] sm:pl-[24px] md:pl-[32px] pr-[16px] sm:pr-[24px] md:pr-[32px]">
        {[
          { label: 'Flyers och\nreklamblad', icon: 'blad-1.svg', slug: 'blad' },
          { label: 'Vikta foldrar', icon: 'foldrar.svg', slug: 'foldrar' },
          { label: 'Broschyrer\noch kataloger', icon: 'broschyrer-1.svg', slug: 'broschyrer' },
          { label: 'Presentations-\nmappar', icon: 'mappar-1.svg', slug: 'mappar' },
          { label: 'Affischer', icon: 'affischer-1.svg', slug: 'affischer' },
          { label: 'Kuvert', icon: 'kuvert-1.svg', slug: 'kuvert' },
          { label: 'Böcker', icon: 'bocker-1.svg', slug: 'bocker' },
          { label: 'Skyltar,\nbanderoller\noch storformat', icon: 'storformat-1.svg', slug: 'storformat' },
        ].map((product) => (
          <a href={`/produkter/${product.slug}`} class="shrink-0 w-[260px] sm:w-[320px] md:w-[380px] min-h-[340px] sm:min-h-[395px] bg-[#F5F5F5] rounded-[16px] p-[24px] sm:p-[34px] flex flex-col items-center text-center group hover:bg-[#EBEBEB] transition-colors duration-200 no-underline relative">
            <img src={`/images/icons/${product.icon}`} alt={product.label} class="w-[72px] h-[72px] sm:w-[90px] sm:h-[90px] mb-[16px] sm:mb-[20px]" />
            <span class="typo-card-title whitespace-pre-line">{product.label}</span>
            <span class="mt-auto self-end text-[#222]">
              <svg width="36" height="36" viewBox="0 0 512 512" fill="currentColor"><path d="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm144 276c0 6.6-5.4 12-12 12h-92v92c0 6.6-5.4 12-12 12h-56c-6.6 0-12-5.4-12-12v-92h-92c-6.6 0-12-5.4-12-12v-56c0-6.6 5.4-12 12-12h92v-92c0-6.6 5.4-12 12-12h56c6.6 0 12 5.4 12 12v92h92c6.6 0 12 5.4 12 12v56z"/></svg>
            </span>
          </a>
        ))}
      </div>
      <div class="flex justify-end gap-2 mt-4 mr-[16px] sm:mr-[24px] md:mr-[32px]">
        <button id="carousel-prev" class="w-[40px] h-[40px] sm:w-[44px] sm:h-[44px] rounded-full bg-[#F5F5F5] flex items-center justify-center text-gray-300 hover:text-[#222] transition-colors cursor-pointer" aria-label="Föregående">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button id="carousel-next" class="w-[40px] h-[40px] sm:w-[44px] sm:h-[44px] rounded-full bg-[#F5F5F5] flex items-center justify-center text-[#222] hover:bg-[#E5E5E5] transition-colors cursor-pointer" aria-label="Nästa">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
    </div>

    <!-- DESKTOP: Bento-grid -->
    <div class="hidden lg:block max-w-[1440px] mx-auto px-[44px]">
      <div class="grid grid-cols-3 grid-rows-4 gap-[16px] auto-rows-[220px]">
        <a href="/produkter/blad" class="col-span-2 row-span-2 bg-[#F5F5F5] rounded-[20px] p-[40px] flex flex-col group hover:bg-[#EBEBEB] transition-colors duration-200 no-underline relative">
          <img src="/images/icons/blad-1.svg" alt="Flyers och reklamblad" class="w-[120px] h-[120px] mb-[20px]" />
          <span class="typo-card-title whitespace-pre-line">Flyers och
reklamblad</span>
          <span class="mt-auto self-end text-[#222]">
