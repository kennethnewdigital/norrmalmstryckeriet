---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
import Stat from '../../../components/admin/Stat.astro';
import StatusPill from '../../../components/admin/StatusPill.astro';
import { getAdminFromRequest } from '../../../lib/auth';
import { listLeads } from '../../../lib/leads';

const admin = await getAdminFromRequest(Astro.cookies);
if (!admin) return Astro.redirect('/admin/login');

const items = await listLeads(500);
const deletedId = Astro.url.searchParams.get('deleted');
const nya = items.filter((i) => i.status === 'ny').length;
const kontaktade = items.filter((i) => i.status === 'kontaktad').length;
const arkiverade = items.filter((i) => i.status === 'arkiverad').length;

const guides = Array.from(new Set(items.map((i) => i.guide))).sort();
const guideCount = (g: string) => items.filter((i) => i.guide === g).length;

function fmt(ts: number) {
  return new Date(ts).toLocaleString('sv-SE', { dateStyle: 'short', timeStyle: 'short' });
}
---

<Layout title="Admin — Nedladdnings-leads | Norrmalmstryckeriet" noindex={true}>
  <section class="page-section">
    <div class="page-container">
      <div class="flex flex-wrap items-end justify-between gap-[16px] mb-[16px]">
        <div>
          <p class="section-label mb-[8px]">Inloggad som {admin.email}</p>
          <h1 class="font-[var(--font-heading)] !font-normal text-[#222]" style="font-size:clamp(1.75rem,4vw,3rem);line-height:1.1;">Nedladdnings-leads</h1>
        </div>
        <form action="/api/admin/logout" method="post">
          <button class="text-[14px] text-[#666] underline">Logga ut</button>
        </form>
      </div>

      <!-- Flik-navigation -->
      <div class="mb-[24px] border-b border-[#E5E5E5] flex gap-[4px]">
        <a href="/admin/" class="px-[16px] py-[10px] text-[14px] text-[#666] hover:text-[#222] border-b-2 border-transparent">Offertförfrågningar</a>
        <a href="/admin/leads/" class="px-[16px] py-[10px] text-[14px] text-[#222] font-medium border-b-2 border-[#D9222A]">Nedladdnings-leads</a>
      </div>

      {deletedId && (
        <div class="mb-[16px] p-[12px] rounded-[10px] bg-[#F0FDF4] border border-[#BBF7D0] text-[#166534] text-[14px]">
          Lead <strong style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;">{deletedId}</strong> har raderats.
        </div>
      )}

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-[12px] mb-[24px]">
        <Stat label="Totalt" value={items.length} />
        <Stat label="Nya" value={nya} tone="red" />
        <Stat label="Kontaktade" value={kontaktade} />
        <Stat label="Arkiverade" value={arkiverade} />
      </div>

      {items.length > 0 && (
        <div class="mb-[24px] p-[16px] rounded-[12px] bg-[#F9F9F9] border border-[#E5E5E5]">
          <p class="text-[11px] uppercase font-medium text-[#666] mb-[10px]" style="letter-spacing:1.2px;">Exportera CSV</p>
          <div class="flex flex-wrap gap-[8px]">
            <a href="/api/admin/leads-export.csv" class="inline-flex items-center gap-[6px] px-[14px] py-[8px] rounded-full bg-[#222] text-white text-[13px] no-underline hover:bg-[#000]">
              📥 Alla ({items.length})
            </a>
            {guides.map((g) => (
              <a href={`/api/admin/leads-export.csv?guide=${encodeURIComponent(g)}`} class="inline-flex items-center gap-[6px] px-[14px] py-[8px] rounded-full border border-[#D5D8DC] text-[#222] text-[13px] no-underline hover:bg-white">
                {g} ({guideCount(g)})
              </a>
            ))}
          </div>
        </div>
      )}

      {items.length === 0 ? (
        <div class="rounded-[16px] bg-[#F5F5F5] p-[40px] text-center text-[#666]">
          Inga nedladdnings-leads än — så snart någon fyller i formuläret för att hämta en guide dyker det upp här.
        </div>
      ) : (
        <div class="rounded-[16px] border border-[#E5E5E5] overflow-hidden">
          <div class="grid grid-cols-[160px_100px_1fr_1fr_120px_80px] gap-[12px] px-[16px] py-[12px] bg-[#F9F9F9] text-[12px] uppercase font-medium text-[#666]" style="letter-spacing:1px;">
            <div>Lead-id</div><div>Datum</div><div>Namn / företag</div><div>Guide</div><div>Status</div><div class="text-right">Öppna</div>
          </div>
          {items.map((it) => (
            <a href={`/admin/leads/${it.id}`} class="grid grid-cols-[160px_100px_1fr_1fr_120px_80px] gap-[12px] px-[16px] py-[14px] border-t border-[#EEE] hover:bg-[#FAFAFA] no-underline items-center">
              <div class="text-[13px] text-[#222] font-medium" style="font-family:ui-monospace,SFMono-Regular,Menlo,monospace;">{it.id}</div>
              <div class="text-[13px] text-[#666]">{fmt(it.ts)}</div>
              <div class="text-[14px] text-[#222]"><strong>{it.namn}</strong>{it.foretag ? ` · ${it.foretag}` : ''}</div>
              <div class="text-[14px] text-[#444]">{it.guideTitle}{it.newsletter ? ' · ✉️' : ''}</div>
              <div><StatusPill status={it.status === 'kontaktad' ? 'hanterad' : it.status} /></div>
              <div class="text-right text-[#D9222A] text-[13px] font-medium">→</div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</Layout>
