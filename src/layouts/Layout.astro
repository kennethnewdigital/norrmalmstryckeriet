---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schemaJson?: string;
  noindex?: boolean;
  breadcrumbs?: Array<{ name: string; href: string }>;
}

const {
  title,
  description = 'Norrmalmstryckeriet – Närproducerade trycksaker i Stockholm. Visitkort, broschyrer, foldrar, affischer och mycket mer.',
  ogImage = '/images/hero/hero-tryckpress.webp',
  ogType = 'website',
  schemaJson,
  noindex = false,
  breadcrumbs,
} = Astro.props;

const SITE_URL = 'https://norrmalmstryckeriet.se';
const pathname = Astro.url.pathname.replace(/\/index\.html$/, '/');
const canonical = new URL(pathname, SITE_URL).href;
const ogImageAbsolute = new URL(ogImage, SITE_URL).href;

const SLUG_NAMES: Record<string, string> = {
  produkter: 'Produkter',
  guider: 'Guider',
  miljo: 'Miljö',
  'om-oss': 'Om oss',
  historia: 'Historia',
  'kontakta-oss': 'Kontakta oss',
  offert: 'Offert',
  kundreferenser: 'Kundreferenser',
  nyheter: 'Nyheter',
  integritetspolicy: 'Integritetspolicy',
  visitkort: 'Visitkort',
  broschyrer: 'Broschyrer',
  foldrar: 'Foldrar',
  affischer: 'Affischer',
  kuvert: 'Kuvert',
  blad: 'Blad',
  mappar: 'Mappar',
  bocker: 'Böcker',
  storformat: 'Storformat',
  'arsredovisningar-rapporter': 'Årsredovisningar & rapporter',
  'rollups-massmaterial': 'Roll-ups & mässmaterial',
  papper: 'Papper & materialval',
  reklamblad: 'Reklamblad',
  massmaterial: 'Roll-ups & mässmaterial',
  offsettryck: 'Offsettryck',
  digitaltryck: 'Digitaltryck',
  industritryck: 'Industritryck & planprint',
  arsredovisning: 'Årsredovisning',
  filhantering: 'Filhantering',
  infografik: 'Infografik',
};

const pathSegments = pathname.split('/').filter(Boolean);
let breadcrumbItems = breadcrumbs;
if (!breadcrumbItems && pathSegments.length > 0) {
  breadcrumbItems = pathSegments.map((seg, i) => ({
    name: SLUG_NAMES[seg] ?? seg.charAt(0).toUpperCase() + seg.slice(1).replace(/-/g, ' '),
    href: '/' + pathSegments.slice(0, i + 1).join('/') + '/',
  }));
}

let breadcrumbSchema: object | null = null;
if (breadcrumbItems && breadcrumbItems.length > 0) {
  breadcrumbSchema = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Hem',
        item: SITE_URL + '/',
      },
      ...breadcrumbItems.map((b, i) => ({
        '@type': 'ListItem',
        position: i + 2,
        name: b.name,
        item: new URL(b.href, SITE_URL).href,
      })),
    ],
  };
}

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': ['Organization', 'LocalBusiness', 'PrintShop'],
  '@id': SITE_URL + '/#organization',
  name: 'Norrmalmstryckeriet',
  legalName: 'AB Norrmalmstryckeriet',
  url: SITE_URL,
  logo: SITE_URL + '/favicon.svg',
  image: SITE_URL + '/images/hero/hero-tryckpress.webp',
  telephone: '+46-8-96-01-35',
  email: 'tryckeri@norrmalmstryckeriet.se',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Hammarbacken 4A',
    postalCode: '191 24',
    postOfficeBoxNumber: 'Box 416',
    addressLocality: 'Sollentuna',
    addressRegion: 'Stockholms län',
    addressCountry: 'SE',
  },
  // TODO: verifiera VAT-ID med Mats/bokföring innan lansering
  // Härledd från orgnr 556088-1681 enligt svensk konvention (SE + orgnr + 01)
  vatID: 'SE556088168101',
  slogan: 'Ditt tryckeri i Stockholm',
  areaServed: [
    { '@type': 'Place', name: 'Sollentuna' },
    { '@type': 'Place', name: 'Häggvik' },
    { '@type': 'Place', name: 'Stockholm' },
    { '@type': 'Place', name: 'Norrort' },
  ],
};
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Norrmalmstryckeriet" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:locale" content="sv_SE" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)}></script>
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)}></script>
    )}
    {schemaJson && (
      <script type="application/ld+json" set:html={schemaJson}></script>
    )}
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <!-- Apple-style reveal-on-scroll (täcker hela siten) -->
    <script is:inline>
      (function () {
        // Selectors that should reveal — broad coverage, like apple.com
        const REVEAL_SELECTORS = [
          // Headings
          'main h1',
          'main h2',
          'main h3',
          'main h4',
          // Section labels (eyebrow text)
          'main .section-label',
          // Body paragraphs (in content blocks)
          'main section p',
          // Cards & articles
          'main article',
          // Grid items (cards in grids)
          'main section .grid > div',
          'main section .grid > article',
          'main section .grid > a',
          // Lists in content
          'main section ul',
          'main section ol',
          // Forms
          'main form',
          // Two-column groups
          'main section .grid',
          // Carousel scrollers
          'main section [id$="-carousel"]',
        ];

        function initReveal() {
          // Auto-add .reveal where appropriate
          const targets = document.querySelectorAll(REVEAL_SELECTORS.join(', '));
          targets.forEach((el) => {
            // Skip if already has reveal, has no-reveal opt-out, or is in header/footer
            if (
              el.classList.contains('reveal') ||
              el.classList.contains('no-reveal') ||
              el.closest('.no-reveal') ||
              el.closest('header') ||
              el.closest('footer')
            ) return;

            // Skip if parent is already going to reveal (avoid double-reveal nesting)
            // Walk up max 3 levels looking for an already-revealing ancestor
            let parent = el.parentElement;
            let depth = 0;
            while (parent && depth < 3) {
              if (parent.classList && parent.classList.contains('reveal')) {
                // If parent already has reveal, only add to children if it's a card-like grid item
                const isGridItem = el.parentElement && el.parentElement.classList && el.parentElement.classList.contains('grid');
                if (!isGridItem) return;
                break;
              }
              parent = parent.parentElement;
              depth++;
            }

            el.classList.add('reveal');
          });

          // Stagger grid children (apple-style cascade)
          document.querySelectorAll('main section .grid').forEach((grid) => {
            const items = Array.from(grid.children).filter(
              (c) => c.classList && c.classList.contains('reveal')
            );
            items.forEach((item, i) => {
              if (!item.style.transitionDelay) {
                item.style.transitionDelay = i * 80 + 'ms';
              }
            });
          });

          // IntersectionObserver to trigger reveals as they enter viewport
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-revealed');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.08, rootMargin: '0px 0px -6% 0px' }
          );

          document.querySelectorAll('.reveal').forEach((el) => {
            const rect = el.getBoundingClientRect();
            // Already in viewport (above the fold) — reveal immediately without animation delay
            if (rect.top < window.innerHeight * 0.95) {
              // Small timeout so transition can register
              setTimeout(() => el.classList.add('is-revealed'), 20);
            } else {
              observer.observe(el);
            }
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initReveal);
        } else {
          initReveal();
        }
        document.addEventListener('astro:after-swap', initReveal);
      })();
    </script>
  </body>
</html>
